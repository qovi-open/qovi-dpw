<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later
     Copyright (C) 2026 Marc Gandar
     FILEVER Product.wxs · 2026-11-18 · lot 19 (W11 : DpW s'ouvre a la fin de l'installation)
     Installation par machine dans Program Files\Qovi\DpW (dossier parent Qovi
     partage par les produits Qovi, ex. Qovi\TuI ; decision de Marc 04.11),
     raccourcis menu Demarrer et bureau, desinstallation propre, mise a jour
     par-dessus une version precedente, y compris l'ancien dossier
     Program Files\Qovi DpW (UpgradeCode FIXE : ne jamais le changer ;
     AllowSameVersionUpgrades : un MSI de meme version remplace l'ancien).
     Variables (wix build -d) : Rel = dossier Release de Flutter, Ver = version,
     Ico = icone. Non signe pour l'instant (decision de Marc 01.11).
     W11 (Marc 18.11) : a la fin d'une installation ou d'une mise a jour faite
     avec l'interface (double-clic), DpW s'ouvre tout seul, pour ne pas laisser
     croire a un plantage. L'action est dans InstallUISequence, APRES
     ExecuteAction : elle tourne dans le processus de l'usager, NON eleve
     (jamais DpW en administrateur). Rien en silencieux (/qn, /qb : pas de
     sequence UI) ni a la desinstallation. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Qovi DpW" Manufacturer="Qovi" Version="$(var.Ver)"
           UpgradeCode="7A56122D-B0BB-48AE-B34C-EF8F16081707" Scope="perMachine" Language="1036">
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="Une version plus récente de Qovi DpW est déjà installée." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="DpwIcon" SourceFile="$(var.Ico)" />
    <Property Id="ARPPRODUCTICON" Value="DpwIcon" />

    <CustomAction Id="LaunchDpw" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]qfa_dpw.exe&quot;"
                  Execute="immediate" Impersonate="yes" Return="asyncNoWait" />
    <InstallUISequence>
      <Custom Action="LaunchDpw" After="ExecuteAction" Condition="NOT Installed AND NOT REMOVE" />
    </InstallUISequence>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="QoviFolder" Name="Qovi">
        <Directory Id="INSTALLFOLDER" Name="DpW">
          <Files Include="$(var.Rel)\**" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="StartMenuDpw" Name="Qovi DpW" Target="[INSTALLFOLDER]qfa_dpw.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="DpwIcon" />
        <RegistryValue Root="HKLM" Key="Software\Qovi\DpW" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut">
        <Shortcut Id="DesktopDpw" Name="Qovi DpW" Target="[INSTALLFOLDER]qfa_dpw.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="DpwIcon" />
        <RegistryValue Root="HKLM" Key="Software\Qovi\DpW" Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Package>
</Wix>
